# ⚙️ VARIABLES DE ENTORNO - Media Dedupe
# 
# Copia este archivo a .env y actualiza con tus valores
# NO commits .env a Git (está en .gitignore)

# 🔐 CREDENCIALES GOOGLE
# Obtenidas de: https://console.cloud.google.com
GOOGLE_DRIVE_CLIENT_ID=tu_client_id_aqui.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=tu_client_secret_aqui
GOOGLE_DRIVE_TOKEN_PATH=secrets/credentials/google-drive-token.json

# 🔐 CREDENCIALES GOOGLE PHOTOS
GOOGLE_PHOTOS_TOKEN_PATH=secrets/credentials/google-photos-token.json

# 🔐 CREDENCIALES ONEDRIVE
# Obtenidas de: https://portal.azure.com
ONEDRIVE_CLIENT_ID=tu_client_id_aqui
ONEDRIVE_CLIENT_SECRET=tu_client_secret_aqui
ONEDRIVE_TOKEN_PATH=secrets/credentials/onedrive-token.json

# 📊 RUTAS DE REPORTES
REPORTES_JSON=reports/latest/duplicados.json
REPORTES_HTML=reports/latest/duplicados.html
REPORTES_CSV=reports/latest/duplicados.csv

# 💾 CACHÉ
MEDIA_CACHE_DB=reports/cache/media_cache.db

# 🔧 CONFIGURACIÓN DE ESCANEO
# Umbral de similitud para imágenes (0-100%)
IMAGE_SIMILARITY_THRESHOLD=95

# Umbral de similitud para videos (0-100%)
VIDEO_SIMILARITY_THRESHOLD=90

# Número de threads para paralelización
NUM_THREADS=4

# 📂 DIRECTORIOS A ESCANEAR (opcional)
# LOCAL_FOLDER_PATH=/ruta/a/carpeta/local
# WHATSAPP_BACKUP_PATH=/ruta/a/whatsapp/media

# 🗑️ ELIMINACIÓN
# Auto-eliminar duplicados (sin confirmación)
# AUTO_DELETE=false

# Crear cuarentena en lugar de eliminar
# QUARANTINE_MODE=false
# QUARANTINE_PATH=reports/quarantine
